{
  "name": "@yourcrm/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun run ./src/migrate.ts",
    "db:seed": "bun run ./src/seed.ts"
  },
  "dependencies": {
    "@yourcrm/config": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  }
}
