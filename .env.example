# ---------------------------------------------------------------------------
# YourCRM — environment template. Copy to `.env` and fill in local values.
# Never commit real credentials. All variables are validated at startup
# by @yourcrm/config (see packages/config/src/env.ts).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000

# PostgreSQL (local Docker Compose maps host 5442 -> container 5432)
DATABASE_URL=postgres://yourcrm:yourcrm_dev@localhost:5442/yourcrm

# Redis (local Docker Compose)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (local MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=yourcrm
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Auth / sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-64-hex-chars-minimum-please-generate-a-real-secret-here
ENCRYPTION_KEY=change-me-64-hex-chars-minimum-please-generate-a-real-secret-here
BETTER_AUTH_SECRET=change-me-please-generate-a-real-secret-here-minimum-32-chars

# OAuth providers (optional for foundation)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Email provider (optional for foundation; pick one)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="YourCRM <noreply@example.com>"

# AI providers (optional; foundation starts without keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_DEFAULT_MODEL=

# MCP
MCP_PORT=4100
# MCP_API_TOKEN=  # optional bearer token for HTTP MCP transport later

# Observability (observability agent)
# /metrics is DISABLED unless this is set — keep it off on public listeners.
# METRICS_ENABLED=1

# Backups (observability agent; see infrastructure/backup/README.md)
# BACKUP_DIR=/var/backups/yourcrm
# RETENTION_DAYS=14
# GPG_RECIPIENT=backups@example.com  # optional: encrypt pg_dump at rest

# Integrations (optional placeholders)
# WHATSAPP_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
