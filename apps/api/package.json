{
  "name": "@yourcrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outfile dist/index.js --external postgres --external ioredis",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@yourcrm/auth": "workspace:*",
    "@yourcrm/config": "workspace:*",
    "@yourcrm/crm": "workspace:*",
    "@yourcrm/database": "workspace:*",
    "@yourcrm/events": "workspace:*",
    "@yourcrm/integrations": "workspace:*",
    "@yourcrm/notifications": "workspace:*",
    "@yourcrm/permissions": "workspace:*",
    "@yourcrm/search": "workspace:*",
    "@yourcrm/storage": "workspace:*",
    "@yourcrm/validation": "workspace:*",
    "@yourcrm/workflows": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.5",
    "ioredis": "^5.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@yourcrm/testing": "workspace:*",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  }
}
